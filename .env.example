# Copy to .env (gitignored) and fill in. In Colab, add the same names under Secrets.

# Which profile in common/llm_config.py to use: free (default, submitted runs) or paid_dev.
LLM_PROFILE=free

# free profile: a Groq free-tier key, plus OpenRouter for the fallback.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# paid_dev profile: a Groq paid-tier key, kept separate so GROQ_API_KEY meets the real free limits.
GROQ_DEV_API_KEY=
